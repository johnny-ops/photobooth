# ICS PHOTOBOOTH - Environment Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# Get these from: https://app.supabase.com/project/[YOUR_PROJECT]/settings/api

# Your Supabase project URL
# Example: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Supabase anonymous key (public key, safe to share)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ========================================
# OPTIONAL CONFIGURATION
# ========================================

# Storage bucket name (default: photobooth-videos)
VITE_STORAGE_BUCKET=photobooth-videos

# Maximum file size in MB (default: 100)
VITE_MAX_FILE_SIZE=100

# Enable debug logging (default: false)
VITE_DEBUG=false

# ========================================
# INSTRUCTIONS
# ========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your Supabase credentials
# 3. Save the file
# 4. Run: npm start
#
# DO NOT commit .env to git!
# Add .env to .gitignore
# ========================================