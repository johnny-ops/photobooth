{
  "name": "web-photobooth",
  "version": "1.0.0",
  "description": "ICS Web Photobooth - Retro Pixelated Photo Experience",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start-web": "serve .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "keywords": ["photobooth", "web", "camera", "photos", "retro", "pixel", "electron"],
  "author": "ICS PHOTOBOOTH",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "serve": "^14.2.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.ics.photobooth",
    "productName": "ICS Photobooth",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "public/**/*",
      "template*.png",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/assets/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/assets/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/assets/icon.png"
    }
  }
}
